{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "ezero-shortlink-pilot",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "vars": {
    "PUBLIC_ORIGIN": "https://coma39658-ctrl.github.io"
  },
  "durable_objects": {
    "bindings": [
      {"name":"SHORT_LINKS","class_name":"ShortInvite"}
    ]
  },
  "migrations": [
    {"tag":"v1","new_sqlite_classes":["ShortInvite"]}
  ]
}
