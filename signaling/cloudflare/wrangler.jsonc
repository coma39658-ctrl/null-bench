{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "ezero-browser-signaling-pilot",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "vars": {
    "PUBLIC_ORIGIN": "https://coma39658-ctrl.github.io"
  },
  "durable_objects": {
    "bindings": [
      {"name": "ROOMS", "class_name": "SignalRoom"}
    ]
  },
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["SignalRoom"]}
  ]
}
