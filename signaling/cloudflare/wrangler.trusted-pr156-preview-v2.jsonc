{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "ezero-trusted-inbox-pr156-preview-v2",
  "main": "src/trusted_inbox_pr156_preview_v2.js",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "vars": {
    "PUBLIC_ORIGIN": "https://ezero-save-friend-pr156-preview-v2.onrender.com"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TRUSTED_INBOXES",
        "class_name": "TrustedInbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TrustedInbox"
      ]
    }
  ]
}
