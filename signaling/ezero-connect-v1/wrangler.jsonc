{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ezero-connect-signal-staging-20261120",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "EzeroConnectRoom"
      },
      {
        "name": "RATE_LIMITER",
        "class_name": "EzeroConnectRateLimit"
      },
      {
        "name": "INBOXES",
        "class_name": "EzeroConnectInbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "EzeroConnectRoom"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "EzeroConnectRateLimit"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "EzeroConnectInbox"
      ]
    }
  ],
  "services": [\n    { "binding": "FRIENDSHIP_REGISTRY", "service": "ezero-friendship-registry-staging-20261127" }\n  ],\n  "vars": {
    "PUBLIC_ORIGIN": "https://ezero-connect-pairing-v2-preview-20261123.onrender.com"
  }
}
