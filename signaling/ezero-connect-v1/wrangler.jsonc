{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ezero-connect-signal-staging-20261120",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "EzeroConnectRoom"
      },
      {
        "name": "RATE_LIMITER",
        "class_name": "EzeroConnectRateLimit"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "EzeroConnectRoom"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "EzeroConnectRateLimit"
      ]
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://ezero-connect-camera-preview-20261120.onrender.com"
  }
}
