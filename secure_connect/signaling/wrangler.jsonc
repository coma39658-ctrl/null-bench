{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "ezero-secure-connect-signaling-staging",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "EZERO_PUBLIC_ENABLED": "false"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PAIR_ROOMS",
        "class_name": "PairRoom"
      }
    ]
  },
  "exports": {
    "PairRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
