{
  // E-ZERO Secure Pair V1 — isolated local-only HTML preview config.
  // DO NOT run "wrangler deploy" on this experimental configuration.
  // Never enables authentication, QR pairing, calls, WebSockets or account data.
  "name": "ezero-secure-pair-preview-disabled",
  "main": "./worker.mjs",
  "compatibility_date": "2026-11-05",
  "workers_dev": false,
  "observability": {"enabled": false},
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Critical security: static assets must never bypass the 503 guard
    // on /api/** even if a future file is mistakenly named api/index.html.
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
